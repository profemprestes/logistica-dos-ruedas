# Copiá este archivo como `keystore.properties` (sin el .ejemplo) y completalo.
#
# EL DE VERDAD NO VA AL REPOSITORIO: tiene la contraseña adentro y está en el
# .gitignore junto con el archivo .jks. Este que sí va es sólo para que alguien
# que abra el proyecto sepa qué hace falta.
#
# La clave se genera una vez, así:
#
#   keytool -genkeypair -v -keystore dosruedas-repartidor.jks \
#           -keyalg RSA -keysize 2048 -validity 10000 -alias dosruedas
#
# Y ese .jks HAY QUE GUARDARLO. Android sólo deja actualizar una app con la
# misma firma con la que se instaló: si se pierde, no se puede sacar nunca más
# una versión nueva de esta app. Habría que desinstalarla de todos los celulares
# y publicar otra con otro nombre de paquete.

# Ojo: barras normales, no invertidas. Java las lee como escape.
storeFile=C:/Users/TuUsuario/dosruedas-repartidor.jks
storePassword=la-que-elegiste
keyAlias=dosruedas
keyPassword=la-misma-si-le-diste-Enter
